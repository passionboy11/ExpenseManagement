## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022/2019 cache/options
.vs/
.vscode/
.vsconfig

# .NET build outputs
project.lock.json
project.fragment.lock.json
artifacts/

# Tye
.tye/

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NPM / Node (if using JS or Blazor interop)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
dist/
wwwroot/lib/

# Visual Studio for Mac
*.userprefs

# Azure Functions / Publish files
.localhistory/
.publishsettings
*.pubxml
*.publishproj

# Backup & report files
*.bak
*.Backup
*.log
*.tlog
*.vspscc
*_i.c
*_p.c
*.tmp
*.tmp_proj
*.cache
*.pdb
*.mdb
*.dbmdl

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
*.trx
*.coverage
*.coveragexml

# Web stuff
wwwroot/
!wwwroot/index.html
!wwwroot/css/
!wwwroot/js/
!wwwroot/assets/

# Secret / environment files
*.env
.env.*
secrets.json
appsettings.*.json
!appsettings.json
!appsettings.Development.json

# VS Code settings
.vscode/
.history/
*.code-workspace

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# Temporary files
~$*
*.tmp
*.temp
*.DS_Store
Thumbs.db

# Docker
**/[Dd]ockerfile
**/[Dd]ocker-compose*.yml
.dockerignore

# SQLite / Local DB files
*.db
*.mdf
*.ldf

# Others
*.ncrunch*
*.ndproj
*.sqlproj
*.cachefile
*.dbmdl
*.jfm
*.pfx
.DS_Store