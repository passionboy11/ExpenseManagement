@inherits LayoutComponentBase

<div class="d-flex">
    <!-- Sidebar -->
    <div class="d-flex flex-column flex-shrink-0 p-3 bg-dark text-white" style="width: 250px; min-height: 100vh;">
        <a href="/dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-wallet2 me-2"></i>
            <span class="fs-8 fw-bold">Expense Management</span>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li><NavLink class="nav-link text-white" href="/dashboard"><i class="bi bi-house-door me-2"></i>Dashboard</NavLink></li>
            <li><NavLink class="nav-link text-white" href="/transactions"><i class="bi bi-cash-coin me-2"></i>Transactions</NavLink></li>
            <li><NavLink class="nav-link text-white" href="/budgets"><i class="bi bi-piggy-bank me-2"></i>Budgets</NavLink></li>
            <li><NavLink class="nav-link text-white" href="/reports"><i class="bi bi-bar-chart me-2"></i>Reports</NavLink></li>
            <li><NavLink class="nav-link text-white" href="/users"><i class="bi bi-people me-2"></i>Users</NavLink></li>
        </ul>
        <hr>
        <div class="text-center">
            <button class="btn btn-outline-light btn-sm w-100"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-3">
        @Body
    </div>
</div>
