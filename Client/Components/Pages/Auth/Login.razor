@page "/login"
@using Client.Services
@layout EmptyLayout
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager nav

<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="flex-column col-12 col-md-4 gap-8 justify-content-center align-items-center p-4 border rounded shadow-sm">
        <h3 class="text-center">Login</h3>

        <label for="email">Email</label>
        <input type="email" name="email" @bind-value="Email" class="form-control" placeholder="Your Email Here" autofocus />

        <label for="password">Password</label>
        <input type="password" name="password" @bind-value="Password" class="form-control" placeholder="Your Password Here" required />
        <div class="flex-column gap-4">

		<span>Don't have an account? <a href="/register">Register here</a></span>
        </div>

        <button class="btn btn-primary mt-4" type="submit" @onclick="handleLogin" disabled="@isSubmitting">Login</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="text-danger mt-2">@errorMessage</div>
        }
    </div>


</div>


@code {
    public string Email { get; set; }
    public string Password { get; set; }
    private bool isSubmitting { get; set; } = false;
    private string errorMessage { get; set; }

    private async Task handleLogin()
    {
        var status = await AuthService.Login(Email, Password);
        if (status)
        {
            nav.NavigateTo("/");
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }
}
