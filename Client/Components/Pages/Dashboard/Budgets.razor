@page "/budgets"
@layout SidebarLayout
@using Radzen

<RadzenCard Style="padding:20px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Budgets Overview</h3>
        <RadzenButton Icon="add_circle" Text="Add Budget" Style="background-color:#4CAF50;color:white;" @onclick="AddBudget" />
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <RadzenCard Style="background-color:#E3F2FD;">
                <h6>Total Budget</h6>
                <h3 class="fw-bold">$@totalBudget.ToString("N2")</h3>
            </RadzenCard>
        </div>
        <div class="col-md-4">
            <RadzenCard Style="background-color:#FFF3E0;">
                <h6>Total Spent</h6>
                <h3 class="fw-bold text-danger">$@totalSpent.ToString("N2")</h3>
            </RadzenCard>
        </div>
        <div class="col-md-4">
            <RadzenCard Style="background-color:#E8F5E9;">
                <h6>Remaining</h6>
                <h3 class="fw-bold text-success">$@(totalBudget - totalSpent).ToString("N2")</h3>
            </RadzenCard>
        </div>
    </div>

    <RadzenDataGrid Data="@budgets" TItem="BudgetModel" AllowPaging="true" AllowSorting="true" PageSize="5"
                    Class="shadow-sm rounded" RowHover="true">
        <Columns>
            <RadzenDataGridColumn TItem="BudgetModel" Property="Category" Title="Category" />
            <RadzenDataGridColumn TItem="BudgetModel" Property="LimitAmount" Title="Budget Limit" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="BudgetModel" Property="SpentAmount" Title="Spent" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="BudgetModel" Title="Progress">
                <Template Context="b">
                    @{
                        var percent = (double)(b.SpentAmount / b.LimitAmount) * 100; // Ensure we cast to double for RadzenProgressBar
                    }
                    <RadzenProgressBar Value="percent" ShowValue="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BudgetModel" Property="StartDate" Title="Start Date" FormatString="{0:yyyy-MM-dd}" />
            <RadzenDataGridColumn TItem="BudgetModel" Property="EndDate" Title="End Date" FormatString="{0:yyyy-MM-dd}" />
            <RadzenDataGridColumn TItem="BudgetModel" Context="b" Title="Status">
                <Template Context="b">
                    @if (b.SpentAmount > b.LimitAmount)
                    {
                        <RadzenBadge Text="Over Budget" Style="background:#E53935;color:white;" />
                    }
                    else
                    {
                        <RadzenBadge Text="On Track" Style="background:#43A047;color:white;" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="BudgetModel" Context="b" Title="Actions" TextAlign="TextAlign.Center" Width="150px">
                <Template Context="b">
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" Style="margin-right:5px;" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<BudgetModel> budgets = new();
    private decimal totalBudget;
    private decimal totalSpent;

    protected override void OnInitialized()
    {
        budgets = new()
        {
            new BudgetModel { Id = 1, Category = "Food", LimitAmount = 500, SpentAmount = 250, StartDate = DateTime.Today.AddDays(-10), EndDate = DateTime.Today.AddDays(20) },
            new BudgetModel { Id = 2, Category = "Transport", LimitAmount = 300, SpentAmount = 150, StartDate = DateTime.Today.AddDays(-5), EndDate = DateTime.Today.AddDays(25) },
            new BudgetModel { Id = 3, Category = "Entertainment", LimitAmount = 200, SpentAmount = 120, StartDate = DateTime.Today.AddDays(-2), EndDate = DateTime.Today.AddDays(28) },
            new BudgetModel { Id = 4, Category = "Utilities", LimitAmount = 400, SpentAmount = 300, StartDate = DateTime.Today.AddDays(-3), EndDate = DateTime.Today.AddDays(30) },
        };

        totalBudget = budgets.Sum(b => b.LimitAmount);
        totalSpent = budgets.Sum(b => b.SpentAmount);
    }

    // Event handler for Add Budget button (you can later add more functionality to this)
    private void AddBudget()
    {
        // Logic to add a new budget
        Console.WriteLine("Add Budget clicked!");
    }

    public class BudgetModel
    {
        public int Id { get; set; }
        public string Category { get; set; } = string.Empty;
        public decimal LimitAmount { get; set; }
        public decimal SpentAmount { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
    }
}
