@page "/transactions"
@using static Client.DTO.TransactionDto
@layout SidebarLayout
@inject TransactionService TransactionService

<RadzenContent ContainerClass="p-4">
    <h3 class="mb-3">💰 Transactions</h3>

    <!-- ... (same UI) ... -->

    <RadzenDataGrid TItem="TransactionResponse" Data="@FilteredTransactions"
                    AllowPaging="true" PageSize="8" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="TransactionResponse" Property="Date" Title="Date" FormatString="{0:MMM dd, yyyy}" />
            <RadzenDataGridColumn TItem="TransactionResponse" Property="Description" Title="Description" />
            <RadzenDataGridColumn TItem="TransactionResponse" Property="Category" Title="Category" />
            <RadzenDataGridColumn TItem="TransactionResponse" Property="Amount" Title="Amount" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="TransactionResponse" Title="Type">
                <Template Context="data">
                    @if (data.Amount >= 0)
                    {
                        <RadzenBadge Text="Income" Style="background:green;color:white;" />
                    }
                    else
                    {
                        <RadzenBadge Text="Expense" Style="background:red;color:white;" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionResponse" Title="Actions">
                <Template Context="data">
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="() => EditTransaction(data)" Class="me-2" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="() => DeleteTransaction(data)" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenContent>

@code {
    private List<TransactionResponse> allTransactions = new();
    private List<TransactionResponse> FilteredTransactions => ApplyAllFilters();

    private string? searchTerm;
    private string? selectedType;
    private string? selectedCategory;
    private DateTime? startDate;
    private DateTime? endDate;

    private List<string> TransactionTypes = new() { "Income", "Expense" };
    private List<string> Categories = new() { "Income", "Food", "Housing", "Utilities", "Transport", "Other" };

    private bool isDialogVisible = false;
    private string dialogTitle = "";
    private TransactionResponse editingTransaction = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        allTransactions = await TransactionService.GetTransactionsAsync();
        StateHasChanged();
    }

    private async Task SaveTransaction()
    {
        if (editingTransaction.Id == 0)
        {
            await TransactionService.CreateTransactionAsync(new CreateTransactionRequest
            {
                Description = editingTransaction.Description,
                Category = editingTransaction.Category,
                Amount = editingTransaction.Amount,
                Date = editingTransaction.Date
            });
        }
        else
        {
            await TransactionService.EditTransactionAsync(new EditTransactionRequest
            {
                Id = editingTransaction.Id,
                Description = editingTransaction.Description,
                Category = editingTransaction.Category,
                Amount = editingTransaction.Amount,
                Date = editingTransaction.Date
            });
        }

        isDialogVisible = false;
        await LoadTransactions();
    }

    private async Task DeleteTransaction(TransactionResponse t)
    {
        await TransactionService.DeleteTransactionAsync(new DeleteTransactionRequest { Id = t.Id });
        await LoadTransactions();
    }

    private List<TransactionResponse> ApplyAllFilters()
    {
        IEnumerable<TransactionResponse> data = allTransactions;

        if (!string.IsNullOrWhiteSpace(searchTerm))
            data = data.Where(t => t.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedCategory))
            data = data.Where(t => t.Category == selectedCategory);

        if (!string.IsNullOrWhiteSpace(selectedType))
            data = selectedType == "Income"
                ? data.Where(t => t.Amount > 0)
                : data.Where(t => t.Amount < 0);

        if (startDate.HasValue)
            data = data.Where(t => t.Date >= startDate.Value);

        if (endDate.HasValue)
            data = data.Where(t => t.Date <= endDate.Value);

        return data.ToList();
    }

    private void ShowAddDialog()
    {
        editingTransaction = new TransactionResponse() { Date = DateTime.Today };
        dialogTitle = "Add Transaction";
        isDialogVisible = true;
    }

    private void EditTransaction(TransactionResponse t)
    {
        editingTransaction = new TransactionResponse
        {
            Id = t.Id,
            Description = t.Description,
            Amount = t.Amount,
            Category = t.Category,
            Date = t.Date
        };
        dialogTitle = "Edit Transaction";
        isDialogVisible = true;
    }
}
