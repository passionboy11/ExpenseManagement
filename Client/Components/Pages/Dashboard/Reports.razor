@page "/reports"
@layout SidebarLayout
@using Radzen
@using Radzen.Blazor

<RadzenCard Style="padding:20px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Financial Reports & Analytics</h3>
        <div class="d-flex gap-2">
            <RadzenDropDown @bind-Value="selectedMonth" Data="@months" Placeholder="Select Month" Style="width:150px" />
            <RadzenDropDown @bind-Value="selectedYear" Data="@years" Placeholder="Select Year" Style="width:120px" />
            <RadzenButton Icon="refresh" Text="Refresh" Style="background-color:#1976D2;color:white;" />
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <RadzenCard Style="background-color:#E8F5E9;">
                <h6>Total Income</h6>
                <h3 class="fw-bold text-success">$@totalIncome.ToString("N2")</h3>
            </RadzenCard>
        </div>
        <div class="col-md-4">
            <RadzenCard Style="background-color:#FFEBEE;">
                <h6>Total Expense</h6>
                <h3 class="fw-bold text-danger">$@totalExpense.ToString("N2")</h3>
            </RadzenCard>
        </div>
        <div class="col-md-4">
            <RadzenCard Style="background-color:#E3F2FD;">
                <h6>Total Savings</h6>
                <h3 class="fw-bold text-primary">$@(totalIncome - totalExpense).ToString("N2")</h3>
            </RadzenCard>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <RadzenCard>
                <h5 class="mb-3">Category-wise Spending</h5>
                <RadzenChart Style="height:300px;">
                    <RadzenColumnSeries Data="@categorySpending" CategoryProperty="Category" ValueProperty="Amount" />
                    <RadzenCategoryAxis Padding="20" />
                    <RadzenValueAxis />
                </RadzenChart>
            </RadzenCard>
        </div>
        <div class="col-md-6">
            <RadzenCard>
                <h5 class="mb-3">Expense Distribution</h5>
                <RadzenChart Style="height:300px;">
                    <RadzenPieSeries Data="@categorySpending" CategoryProperty="Category" ValueProperty="Amount" />
                </RadzenChart>
            </RadzenCard>
        </div>
    </div>

    <RadzenCard>
        <h5 class="mb-3">Monthly Transactions Summary</h5>
        <RadzenDataGrid Data="@monthlySummary" TItem="TransactionSummary" AllowPaging="true" AllowSorting="true" PageSize="5" Class="shadow-sm rounded">
            <Columns>
                <RadzenDataGridColumn TItem="TransactionSummary" Property="Month" Title="Month" />
                <RadzenDataGridColumn TItem="TransactionSummary" Property="TotalIncome" Title="Total Income" FormatString="{0:C}" />
                <RadzenDataGridColumn TItem="TransactionSummary" Property="TotalExpense" Title="Total Expense" FormatString="{0:C}" />
                <RadzenDataGridColumn TItem="TransactionSummary" Title="Net Savings">
                    <Template Context="item">
                        <span class="fw-bold @(item.TotalIncome - item.TotalExpense >= 0 ? "text-success" : "text-danger")">
                            @(item.TotalIncome - item.TotalExpense).ToString("C")
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</RadzenCard>

@code {
    private List<CategorySpending> categorySpending = new();
    private List<TransactionSummary> monthlySummary = new();
    private decimal totalIncome;
    private decimal totalExpense;
    private string selectedMonth = "October";
    private int selectedYear = DateTime.Now.Year;

    private List<string> months = new()
    {
        "January","February","March","April","May","June","July","August","September","October","November","December"
    };

    private List<int> years = new() { 2023, 2024, 2025 };

    protected override void OnInitialized()
    {
        // Dummy category spending data
        categorySpending = new()
        {
            new CategorySpending { Category = "Food", Amount = 400 },
            new CategorySpending { Category = "Transport", Amount = 150 },
            new CategorySpending { Category = "Entertainment", Amount = 200 },
            new CategorySpending { Category = "Utilities", Amount = 300 },
            new CategorySpending { Category = "Health", Amount = 100 },
        };

        // Dummy monthly summary
        monthlySummary = new()
        {
            new TransactionSummary { Month = "January", TotalIncome = 2500, TotalExpense = 1800 },
            new TransactionSummary { Month = "February", TotalIncome = 2700, TotalExpense = 2000 },
            new TransactionSummary { Month = "March", TotalIncome = 2600, TotalExpense = 1900 },
            new TransactionSummary { Month = "April", TotalIncome = 2800, TotalExpense = 2100 },
            new TransactionSummary { Month = "May", TotalIncome = 2900, TotalExpense = 2200 },
            new TransactionSummary { Month = "June", TotalIncome = 3000, TotalExpense = 2300 },
        };

        totalIncome = monthlySummary.Average(x => x.TotalIncome);
        totalExpense = monthlySummary.Average(x => x.TotalExpense);
    }

    public class CategorySpending
    {
        public string Category { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    public class TransactionSummary
    {
        public string Month { get; set; } = string.Empty;
        public decimal TotalIncome { get; set; }
        public decimal TotalExpense { get; set; }
    }
}
